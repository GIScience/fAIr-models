  ],
  "id": "dinov3s-buildings",
  "geometry": {
    "type": "Polygon",
    "coordinates": [
      [
        [-180, -90],
        [180, -90],
        [180, 90],
        [-180, 90],
        [-180, -90]
      ]
    ]
  },
  "bbox": [-180, -90, 180, 90],
  "properties": {
    "datetime": "2026-05-21T00:00:00Z",
    "created": "2026-05-18T00:00:00Z",
    "updated": "2026-05-21T00:00:00Z",
    "title": "DINO Road Surface",
    "description": "Frozen DINOv3-ViT-S/16 (LVD1689M) encoder with a Attention Pooling and Linear Classifier for Mulit Instance Learning and Prediction",
    "mlm:name": "dinov3s-road-surface",
    "mlm:architecture": "ViT-S/16",
    "mlm:tasks": ["classication"],
    "mlm:framework": "PyTorch",
    "mlm:framework_version": "2.7.1",
    "mlm:pretrained": true,
    "mlm:pretrained_source": "https://arxiv.org/abs/2508.10104",
    "mlm:accelerator": "amd64",
    "mlm:accelerator_count": 1,
    "fair:pinned": true,
    "fair:min_scale": 1,
    "fair:node_pool": "ml-big8",
    "fair:cpu_request": "1",
    "fair:cpu_limit": "2",
    "fair:memory_request": "4Gi",
    "fair:memory_limit": "6Gi",
    "fair:recommended_zoom": 20,
    "fair:source_imagery": "https://tiles.openaerialmap.org/690585b76415e43597ffd7ea/0/690585b76415e43597ffd7eb/{z}/{x}/{y}",
    "fair:preview": {
      "center": [-13.23723, 8.47532],
      "zoom": { "recommended": 20, "min": 14, "max": 22 },
      "imagery": {
        "url": "https://tiles.openaerialmap.org/690585b76415e43597ffd7ea/0/690585b76415e43597ffd7eb/{z}/{x}/{y}",
        "type": "tms",
        "name": "OpenAerialMap - Freetown",
        "attribution": "OpenAerialMap"
      },
      "place": { "name": "Freetown", "country": "Sierra Leone", "country_code": "SL" }
    },
    "keywords": ["Highways", "Classification"],
    "license": "MIT",
    "version": "1",
    "deprecated": false,
    "providers": [
      {
        "name": "HeiGIT",
        "roles": ["producer", "processor"],
        "url": "https://github.com/kshitijrajsharma/dinov3-hot-ablation",
        "description": "Author of the dinov3-hot-ablation model recipe (decoder, multi-task training, watershed + DP+MBR-safe vectorisation)."
      },
      {
        "name": "Facebook Research",
        "roles": ["licensor"],
        "url": "https://arxiv.org/abs/2508.10104",
        "description": "DINOv3-ViT-S/16 encoder, used frozen, with finetuned weights."
      },
      {
        "name": "HOTOSM",
        "roles": ["host"],
        "url": "https://www.hotosm.org",
        "description": "Humanitarian OpenStreetMap Team"
      }
    ],
    "fair:metrics_spec": [
      {
        "key": "fair:accuracy",
        "name": "Predicted Accuracy",
        "description": "TODO"
      }
    ],
    "mlm:input": [
      {
        "name": "RGB chips",
        "bands": [{ "name": "red" }, { "name": "green" }, { "name": "blue" }],
        "input": {
          "shape": [-1, 3, 256, 256],
          "dim_order": ["batch", "bands", "height", "width"],
          "data_type": "float32"
        },
        "pre_processing_function": {
          "format": "python",
          "expression": "models.dinov3s_road_surface_classication.pipeline:preprocess"
        }
      }
    ],
    "mlm:output": [
      {
        "name": "rooad-classication",
        "tasks": ["classification"],
        "result": {
          "shape": [-1, 2],
          "dim_order": ["batch", "class"],
          "data_type": "float32"
        },
        "description": "Per Road Classification.",
        "classification:classes": [
          {
            "name": "unpaved",
            "value": 0,
            "description": "Road surface type with out continous pavement (eg. asphalt, concrete or tarmac) or segmented pavement (eg. sett, cobblestone or paving stones)"
          },
          {
            "name": "paved",
            "value": 1,
            "description": "Road surface type with out continous pavement (eg. asphalt, concrete or tarmac) or segmented pavement (eg. sett, cobblestone or paving stones),"
          }
        ],
        "post_processing_function": {
          "format": "python",
          "expression": "models.yolo_swag_waste_grid_segmentation.pipeline:postprocess"
        },
        "bands": []
      }
    ],
    "cube:dimensions": {
      "features": {
        "type": "geometry",
        "bbox": [-180, -90, 180, 90],
        "geometry_types": ["Polygon"],
        "reference_system": 4326
      }
    },
    "cube:variables": {
      "class": {
        "dimensions": ["features"],
        "type": "data",
        "description": "Predicted class value (1 = building).",
        "values": [1],
        "data_type": "uint8"
      },
      "score": {
        "dimensions": ["features"],
        "type": "data",
        "description": "Mean building probability over the polygon.",
        "extent": [0, 1],
        "data_type": "float32"
      }
    },
    "mlm:hyperparameters": {
      "training.epochs": 1,
      "training.val_ratio": 0.2,
      "training.split_seed": 42,
      "training.block_size_m": 100.0,
      "inference.confidence_threshold": 0.5
    },
    "fair:split_spec": {
      "strategy": "spatial",
      "default_ratio": 0.2,
      "seed": 42,
      "block_size_m": 100.0,
      "description": "Spatial block split by road: roads are grouped into block_size_m grid blocks (UTM) by their centroid and whole blocks go to val in seeded order until it holds about default_ratio of the roads. A single block falls back to a random split by road. Not stratified by class."
    },
    "fair:hyperparameters_spec": [
      {
        "key": "epochs",
        "type": "int",
        "default": 1,
        "min": 1,
        "max": 1,
        "description": "Required by fAIr; the fine-tuning length is set by steps (step 2)."
      },
      {
        "key": "val_ratio",
        "type": "float",
        "default": 0.2,
        "min": 0.05,
        "max": 0.5,
        "description": "Share of each class's labelled roads held out for validation."
      },
      {
        "key": "split_seed",
        "type": "int",
        "default": 42,
        "min": 0,
        "max": 2147483647,
        "description": "Seed of the block order in the spatial split."
      },
      {
        "key": "block_size_m",
        "type": "float",
        "default": 100.0,
        "min": 10.0,
        "max": 5000.0,
        "description": "Side length in metres of the grid blocks that keep neighbouring roads on one side of the split; larger blocks = stronger spatial separation, fewer blocks to split."
      },
      {
        "key": "confidence_threshold",
        "type": "float",
        "default": 0.5,
        "min": 0.5,
        "max": 0.99,
        "description": "Below this softmax confidence a road is classed unknown."
      }
    ]
  },
  "assets": {
