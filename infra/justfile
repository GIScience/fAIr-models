set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

ns := "fair"
kind_cluster := "fair"
pid_file := ".port-forward.pids"

# ---------------------------------------------------------------------------
# Public commands. Pass `dok8s` as first arg to target DigitalOcean instead of kind.
# ---------------------------------------------------------------------------

[doc('Deploy the full stack (default kind, pass `dok8s` for DigitalOcean)')]
up env="dev":
    @if [[ "{{ env }}" == "dok8s" ]]; then just _up-dok8s; else just _up-dev; fi

[doc('Stop the stack (port-forwards for kind, helm uninstall for dok8s)')]
down env="dev":
    @if [[ "{{ env }}" == "dok8s" ]]; then just _down-dok8s; else just _down-dev; fi

[doc('Destroy everything (kind cluster or dok8s tofu state)')]
tear env="dev":
    @if [[ "{{ env }}" == "dok8s" ]]; then just _tear-dok8s; else just _tear-dev; fi

[doc('Show service URLs')]
urls env="dev":
    @if [[ "{{ env }}" == "dok8s" ]]; then just _urls-dok8s; else just _urls-dev; fi

[doc('Show cluster + pod health')]
status:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl get nodes -o wide --no-headers 2>/dev/null | sed 's/^/  /' || echo "no context"
    echo
    echo "Pods ({{ ns }}):"
    kubectl get pods -n {{ ns }} --no-headers 2>/dev/null | sed 's/^/  /'

[doc('Run all 3 example pipelines (segmentation, classification, detection)')]
example env="dev":
    @if [[ "{{ env }}" == "dok8s" ]]; then just _example-dok8s; else just _example-dev; fi

[doc('Smoke-test live KNative predict services (dok8s only)')]
predict:
    #!/usr/bin/env bash
    set -euo pipefail
    source .env.dok8s
    for svc in unet-segmentation resnet18-classification yolo11n-detection; do
        url="https://predict.${FAIR_DOMAIN}/${svc}/health"
        printf "%-30s " "$svc"
        if curl -sfk --max-time 30 "$url" >/dev/null; then echo "ok"; else echo "fail ($url)"; fi
    done

# ---------------------------------------------------------------------------
# Internals: dev (kind)
# ---------------------------------------------------------------------------

_up-dev: _ensure-kind _apply-postgres _helmfile-dev _port-forward _seed-dev _stack-register-dev
    @just _urls-dev

_ensure-kind:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! kind get clusters 2>/dev/null | grep -qx {{ kind_cluster }}; then
        kind create cluster --name {{ kind_cluster }} --config kind-config.yaml
    fi

_apply-postgres:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl create ns {{ ns }} --dry-run=client -o yaml | kubectl apply -f -
    kubectl apply -f manifests/postgres.yaml
    kubectl rollout status -n {{ ns }} statefulset/postgres --timeout=180s

_helmfile-dev:
    helmfile -e dev apply

_port-forward:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f {{ pid_file }} ]] && kill -0 "$(head -1 {{ pid_file }})" 2>/dev/null; then exit 0; fi
    just _kill-port-forward
    mkdir -p .pf-logs
    while read -r svc ports; do
        ( while true; do
            kubectl port-forward -n {{ ns }} "svc/$svc" "$ports" >>.pf-logs/"$svc".log 2>&1 || true
            sleep 2
        done ) & echo $! >> {{ pid_file }}
    done < ports.conf
    while read -r svc ports; do
        for i in $(seq 1 30); do nc -z localhost "${ports%%:*}" 2>/dev/null && break; sleep 1; done
    done < ports.conf

_kill-port-forward:
    #!/usr/bin/env bash
    set -uo pipefail
    if [[ -f {{ pid_file }} ]]; then
        while read -r pid; do
            kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
        done < {{ pid_file }}
        rm -f {{ pid_file }}
    fi
    rm -rf .pf-logs

_seed-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    AWS_ENDPOINT_URL=http://localhost:9000 \
    AWS_ACCESS_KEY_ID=minioadmin \
    AWS_SECRET_ACCESS_KEY=minioadmin \
    S3_BUCKET=fair-data \
        uv run --with boto3 python scripts/seed_data.py

_stack-register-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    for i in 1 2 3 4 5; do
        uv run zenml connect --url http://localhost:8080 --username default --password '' --no-verify-ssl && break
        echo "zenml connect: attempt $i, retrying in 5s..." >&2
        sleep 5
    done
    uv run zenml stack import dev -f ../stacks/local.yaml --ignore-version-mismatch || true
    uv run zenml stack import k8s -f ../stacks/k8s.yaml --ignore-version-mismatch || true
    uv run zenml stack set k8s

_down-dev: _kill-port-forward
    @echo "Port-forwards stopped. 'just up' to resume."

_tear-dev: _kill-port-forward
    -helmfile -e dev destroy
    -kubectl delete -f manifests/postgres.yaml --ignore-not-found
    -kind delete cluster --name {{ kind_cluster }}

_urls-dev:
    @echo "ZenML:  http://localhost:8080"
    @echo "MLflow: http://localhost:5000"
    @echo "STAC:   http://localhost:8082"
    @echo "MinIO:  http://localhost:9001  (console)"

_example-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    cd ..
    uv run zenml stack set k8s
    for ex in segmentation classification detection; do
        AWS_ENDPOINT_URL=http://localhost:9000 \
            uv run --group example python "examples/$ex/run.py" \
                --stac-api-url http://localhost:8082 \
                --dsn postgresql://postgres:postgres@localhost:5432/fair_models || \
            AWS_ENDPOINT_URL=http://localhost:9000 \
            FAIR_STAC_API_URL=http://localhost:8082 \
            FAIR_DSN=postgresql://postgres:postgres@localhost:5432/fair_models \
                uv run --group example python "examples/$ex/run.py"
    done

# ---------------------------------------------------------------------------
# Internals: dok8s (DigitalOcean)
# ---------------------------------------------------------------------------

_up-dok8s: _tofu-apply _save-kubeconfig _apply-postgres _helmfile-dok8s _post-deploy-dok8s _seed-dok8s _stack-register-dok8s _write-env-dok8s
    @just _urls-dok8s

_tofu-apply:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s && tofu init -upgrade && tofu apply -auto-approve

_save-kubeconfig:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s
    CTX="$(tofu output -raw doks_context)"
    doctl kubernetes cluster kubeconfig save "${CTX#do-*-}"

_helmfile-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    set -a; source dok8s/.env.helmfile; set +a
    helmfile -e dok8s apply

_post-deploy-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s
    set -a; source .env.helmfile; set +a
    cd ..
    kubectl apply -f manifests/knative-serving.yaml
    kubectl apply -f manifests/s3-credentials.yaml.gotmpl
    just _wait-lb
    just _set-dns
    kubectl wait --for=condition=Available deployment/cert-manager-webhook -n cert-manager --timeout=180s
    envsubst < manifests/cluster-issuer.yaml.gotmpl | kubectl apply -f -
    envsubst < manifests/ingress.yaml.gotmpl | kubectl apply -f -

_wait-lb:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Waiting for ingress LoadBalancer IP..."
    for i in $(seq 1 60); do
        IP=$(kubectl get svc -n ingress-nginx ingress-nginx-controller \
            -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)
        [[ -n "$IP" ]] && { echo "$IP" > dok8s/.lb-ip; echo "  $IP"; exit 0; }
        sleep 5
    done
    echo "ERROR: LoadBalancer IP not assigned after 5 minutes" >&2; exit 1

_set-dns:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s
    set -a; source .env.helmfile; set +a
    IP=$(cat .lb-ip)
    ZONE=$(echo "$FAIR_DOMAIN" | awk -F. '{print $(NF-1)"."$NF}')
    NAME=$(echo "$FAIR_DOMAIN" | sed "s/\.$ZONE\$//")
    EXISTING=$(doctl compute domain records list "$ZONE" --format ID,Type,Name --no-header 2>/dev/null \
        | awk -v t=A -v n="*.$NAME" '$2==t && $3==n {print $1}')
    if [[ -n "$EXISTING" ]]; then
        for id in $EXISTING; do
            doctl compute domain records update "$ZONE" --record-id "$id" --record-data "$IP" >/dev/null
        done
    else
        doctl compute domain records create "$ZONE" --record-type A --record-name "*.$NAME" --record-data "$IP" --record-ttl 300 >/dev/null
    fi
    echo "DNS *.$FAIR_DOMAIN -> $IP"

_seed-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl port-forward -n {{ ns }} svc/minio 9001:9000 >/dev/null 2>&1 &
    PF_PID=$!
    trap "kill $PF_PID 2>/dev/null || true" EXIT
    for i in $(seq 1 20); do nc -z localhost 9001 2>/dev/null && break; sleep 1; done
    AWS_ENDPOINT_URL=http://localhost:9001 \
    AWS_ACCESS_KEY_ID=minioadmin \
    AWS_SECRET_ACCESS_KEY=minioadmin \
    S3_BUCKET=fair-data \
        uv run --with boto3 python scripts/seed_data.py

_stack-register-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s
    set -a; source .env.helmfile; set +a
    cd ..
    export ZENML_URL="https://zenml.${FAIR_DOMAIN}"
    TOKEN=$(scripts/zenml-token.sh --wait)
    export ZENML_STORE_URL="$ZENML_URL"
    export ZENML_STORE_API_TOKEN="$TOKEN"
    export ZENML_STORE_VERIFY_SSL="true"
    export DOKS_CONTEXT="$(cd dok8s && tofu output -raw doks_context)"
    envsubst < ../stacks/dok8s.yaml > dok8s/.dok8s-stack-resolved.yaml
    uv run zenml stack set default 2>/dev/null || true
    echo y | uv run zenml stack delete dok8s 2>/dev/null || true
    for kind in orchestrator artifact-store experiment-tracker container-registry; do
        for name in doks_orchestrator s3_artifacts mlflow_tracker ghcr; do
            echo y | uv run zenml $kind delete $name 2>/dev/null || true
        done
    done
    uv run zenml stack import dok8s -f dok8s/.dok8s-stack-resolved.yaml --ignore-version-mismatch
    uv run zenml stack set dok8s
    rm -f dok8s/.dok8s-stack-resolved.yaml

_write-env-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s
    set -a; source .env.helmfile; set +a
    cd ..
    DOKS_CONTEXT="$(cd dok8s && tofu output -raw doks_context)"
    {
        echo "export ZENML_STORE_URL=\"https://zenml.${FAIR_DOMAIN}\""
        echo "export ZENML_STORE_VERIFY_SSL=\"true\""
        echo "export FAIR_DSN=\"postgresql://postgres:postgres@localhost:5432/fair_models\""
        echo "export FAIR_STAC_API_URL=\"https://stac.${FAIR_DOMAIN}/stac\""
        echo "export FAIR_LABEL_DOMAIN=\"${FAIR_DOMAIN}\""
        echo "export FAIR_DOMAIN=\"${FAIR_DOMAIN}\""
        echo "export FAIR_USER_ID=\"krschap\""
        echo "export FAIR_UPLOAD_ARTIFACTS=\"true\""
        echo "export FAIR_FORCE_CPU=\"1\""
        echo "export AWS_ENDPOINT_URL=\"https://s3.${FAIR_DOMAIN}\""
        echo "export FAIR_S3_PUBLIC_URL=\"https://s3.${FAIR_DOMAIN}\""
        echo "export AWS_ACCESS_KEY_ID=\"minioadmin\""
        echo "export AWS_SECRET_ACCESS_KEY=\"minioadmin\""
        echo "export AWS_REQUEST_CHECKSUM_CALCULATION=\"when_required\""
        echo "export AWS_RESPONSE_CHECKSUM_VALIDATION=\"when_required\""
        echo "export DOKS_CONTEXT=\"${DOKS_CONTEXT}\""
    } > .env.dok8s
    echo "Wrote .env.dok8s. Use: source infra/.env.dok8s before running examples locally."

_down-dok8s:
    -helmfile -e dok8s destroy

_tear-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    -helmfile -e dok8s destroy 2>/dev/null || true
    cd dok8s && tofu destroy -auto-approve

_urls-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dok8s
    set -a; source .env.helmfile 2>/dev/null || true; set +a
    DOMAIN="${FAIR_DOMAIN:-$(tofu output -raw fair_domain 2>/dev/null || echo unknown)}"
    echo "ZenML:   https://zenml.${DOMAIN}"
    echo "MLflow:  https://mlflow.${DOMAIN}"
    echo "STAC:    https://stac.${DOMAIN}/stac"
    echo "Predict: https://predict.${DOMAIN}"

_example-dok8s:
    #!/usr/bin/env bash
    set -euo pipefail
    [[ -f .env.dok8s ]] || { echo "ERROR: .env.dok8s missing - run 'just up dok8s' first"; exit 1; }
    source .env.dok8s
    set -a; source dok8s/.env.helmfile; set +a
    PG_PORT=15432
    kubectl port-forward -n {{ ns }} svc/postgres ${PG_PORT}:5432 >/tmp/pf-pg.log 2>&1 &
    PG_PID=$!
    trap "kill $PG_PID 2>/dev/null || true" EXIT
    for i in $(seq 1 20); do nc -z localhost $PG_PORT 2>/dev/null && break; sleep 1; done
    export FAIR_DSN="postgresql://postgres:postgres@localhost:${PG_PORT}/fair_models"
    export ZENML_URL="$ZENML_STORE_URL"
    export ZENML_STORE_API_TOKEN="$(scripts/zenml-token.sh)"
    cd ..
    for ex in segmentation classification detection; do
        echo "=== $ex ==="
        uv run --group example python "examples/$ex/run.py"
    done
